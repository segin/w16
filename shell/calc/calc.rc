/*
 * calc.rc - w16 Calculator resources.
 *
 * The menu, accelerators, dialog layouts and button labels are Windows
 * 3.1 Calculator's as observed (its resources read as data with
 * tools/resdump.py, and SNAP window dumps). The icon is our own artwork
 * (tools/mkcalcicon.py), and so is the About text.
 */
#include <windows.h>
#include "calc.h"

SC ICON "calc.ico"

SM MENU
BEGIN
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Copy\tCtrl+C",               IDM_COPY
        MENUITEM "&Paste\tCtrl+V",              IDM_PASTE
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Scientific",                 IDM_SCIENTIFIC
        MENUITEM "S&tandard",                   IDM_STANDARD
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents",                   IDM_HELPCONTENTS
        MENUITEM "&Search for Help On...",      IDM_HELPSEARCH
        MENUITEM "&How to Use Help",            IDM_HELPHELP
        MENUITEM SEPARATOR
        MENUITEM "&About Calculator...",        IDM_ABOUT
    END
END

SC DIALOG 310, 65, 240, 158
STYLE WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CLASS "SciCalc"
CAPTION "Calculator"
BEGIN
    CONTROL "Hex", IDC_HEX, "Button", BS_RADIOBUTTON | WS_CHILD | WS_VISIBLE, 8, 24, 28, 10
    CONTROL "Dec", IDC_DEC, "Button", BS_RADIOBUTTON | WS_CHILD | WS_VISIBLE, 36, 24, 28, 10
    CONTROL "Oct", IDC_OCT, "Button", BS_RADIOBUTTON | WS_CHILD | WS_VISIBLE, 64, 24, 28, 10
    CONTROL "Bin", IDC_BIN, "Button", BS_RADIOBUTTON | WS_CHILD | WS_VISIBLE, 92, 24, 28, 10
    CONTROL "", IDC_SIZE1, "Button", BS_RADIOBUTTON | WS_CHILD | WS_VISIBLE, 134, 24, 36, 10
    CONTROL "", IDC_SIZE2, "Button", BS_RADIOBUTTON | WS_CHILD | WS_VISIBLE, 170, 24, 30, 10
    CONTROL "", IDC_SIZE3, "Button", BS_RADIOBUTTON | WS_CHILD | WS_VISIBLE, 204, 24, 30, 10
    CONTROL "Hyp", IDC_HYP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 130, 40, 30, 10
    CONTROL "Inv", IDC_INV, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 92, 40, 30, 10
    CONTROL "", IDD_STATTEXT, "Static", SS_LEFT | WS_GROUP | WS_CHILD | WS_VISIBLE, 170, 41, 16, 9
    CONTROL "", IDD_MEMSCI, "Static", SS_LEFT | WS_GROUP | WS_CHILD | WS_VISIBLE, 196, 41, 12, 9
    CONTROL "", IDD_MEMSTD, "Static", SS_LEFT | WS_GROUP | WS_CHILD | WS_VISIBLE, 100, 24, 11, 9
    CONTROL "", IDD_PARENS, "Static", SS_LEFT | WS_GROUP | WS_CHILD | WS_VISIBLE, 218, 41, 16, 10
    CONTROL "", IDD_DISPSCI, "Static", SS_RIGHT | WS_GROUP | WS_CHILD | WS_VISIBLE, 100, 6, 128, 8
    CONTROL "", IDD_DISPSTD, "Static", SS_RIGHT | WS_GROUP | WS_CHILD | WS_VISIBLE, 25, 6, 93, 8
END

SB DIALOG 80, 80, 146, 86
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "Statistics Box"
FONT 8, "Helv"
BEGIN
    CONTROL "", IDD_STATLIST, "ListBox", LBS_NOTIFY | WS_VSCROLL | WS_BORDER | WS_CHILD | WS_VISIBLE, 3, 3, 140, 50
    CONTROL "&RET", IDD_RET, "Button", BS_DEFPUSHBUTTON | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 4, 58, 28, 14
    CONTROL "&LOAD", IDD_LOAD, "Button", BS_PUSHBUTTON | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 40, 58, 28, 14
    CONTROL "&CD", IDD_CD, "Button", BS_PUSHBUTTON | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 76, 58, 28, 14
    CONTROL "C&AD", IDD_CAD, "Button", BS_PUSHBUTTON | WS_TABSTOP | WS_CHILD | WS_VISIBLE, 112, 58, 28, 14
    CONTROL "n=", IDD_STATNL, "Static", SS_CENTER | WS_GROUP | WS_CHILD | WS_VISIBLE, 66, 76, 8, 8
    CONTROL "0", IDD_STATN, "Static", SS_LEFT | WS_GROUP | WS_CHILD | WS_VISIBLE, 74, 76, 32, 8
END

