1 VERSIONINFO
FILEVERSION 3, 10, 0, 0
PRODUCTVERSION 3, 10, 0, 0
FILEOS 0x00010001L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName", "the w16 contributors\0"
            VALUE "FileDescription", "w16 Calculator\0"
            VALUE "FileVersion", "3.10\0"
            VALUE "InternalName", "Calc\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 the w16 contributors (MIT licence)\0"
            VALUE "OriginalFilename", "CALC.EXE\0"
            VALUE "ProductName", "w16\0"
            VALUE "ProductVersion", "3.10\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
