# wlink directives for the Windows 2.x build of CALC.EXE: fixed segments
# (see shell/progman/progman2.lnk); no WIN87EM, no SHELL.DLL
format windows
option quiet
option start=start
option stack=8k
option heapsize=4k
option description 'w16 Calculator'
segment class 'CODE' fixed preload
segment class 'DATA' fixed preload
library windows.lib
