/* Find: COMMDLG's FindText with this template (the original's, with
   "Match Whole Word Only" placed outside the box); the 2.x build runs
   it as its own modeless dialog */
IDD_FIND2 DIALOG 30, 73, 236, 62
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Find"
CF_FONT
BEGIN
    CONTROL         "Fi&nd What:", -1, "Static", SS_LEFT, 4, 8, 42, 8
    CONTROL         "", IDC_FINDTEXT, "Edit", WS_BORDER | WS_TABSTOP | WS_GROUP | ES_AUTOHSCROLL, 47, 7, 128, 12
    CONTROL         "Match &Whole Word Only", 1040, "Button", CF_CHECK | WS_TABSTOP | WS_GROUP, 4, 99, 100, 12
    CONTROL         "Match &Case", IDC_MATCHCASE, "Button", CF_CHECK | WS_TABSTOP, 4, 38, 64, 12
    CONTROL         "Direction", -1, "Button", BS_GROUPBOX, 107, 26, 68, 28
    CONTROL         "&Up", IDC_FINDUP, "Button", CF_RADIO | WS_TABSTOP | WS_GROUP, 111, 38, 20, 12
    CONTROL         "&Down", IDC_FINDDOWN, "Button", CF_RADIO | WS_TABSTOP, 138, 38, 30, 12
    DEFPUSHBUTTON   "&Find Next", IDOK, 182, 5, 50, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 182, 23, 50, 14, WS_GROUP
    PUSHBUTTON      "&Help", 1038, 182, 45, 50, 14, WS_GROUP
END

