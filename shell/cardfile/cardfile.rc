/*
 * cardfile.rc - w16 Cardfile resources.
 *
 * Menu, accelerators, dialog layouts (in dialog units, with the original
 * templates' "Helv" 8 font) and message texts match Windows 3.1's
 * Cardfile, read as data from its NE resources (tools/nerc.py) and
 * checked against screenshots of it. The icon is our own artwork
 * (tools/mkcardicon.py). The 2.x build leaves out what Windows 2.x
 * cannot read (dialog fonts) and has its own Open, Save As, Find and
 * About boxes in place of COMMDLG's and SHELL's.
 */
#include <windows.h>
#include "cardfile.h"

#ifdef W16_WIN2
#define CF_FONT
#else
#define CF_FONT FONT 8, "Helv"
#endif

IDI_CARDFILE ICON "cardfile.ico"

IDM_MAIN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New",                    IDM_NEW
        MENUITEM "&Open...",                IDM_OPEN
        MENUITEM "&Save",                   IDM_SAVE
        MENUITEM "Save &As...",             IDM_SAVEAS
        MENUITEM "&Print",                  IDM_PRINT
        MENUITEM "Print A&ll",              IDM_PRINTALL
        MENUITEM "Page Se&tup...",          IDM_PAGESETUP
        MENUITEM "P&rint Setup...",         IDM_PRINTSETUP
        MENUITEM "&Merge...",               IDM_MERGE
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                   IDM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",           IDM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",            IDM_CUT
        MENUITEM "&Copy\tCtrl+C",           IDM_COPY
        MENUITEM "&Paste\tCtrl+V",          IDM_PASTE
        MENUITEM "Paste &Link",             IDM_PASTELINK
        MENUITEM "Paste &Special...",       IDM_PASTESPECIAL
        MENUITEM "&Index...\tF6",           IDM_INDEX
        MENUITEM "&Restore",                IDM_RESTORE
        MENUITEM SEPARATOR
        MENUITEM "Te&xt",                   IDM_TEXT, CHECKED
        MENUITEM "Pictur&e",                IDM_PICTURE
        MENUITEM SEPARATOR
        MENUITEM "Lin&k...",                IDM_LINKS
        MENUITEM "&Object",                 IDM_OBJECT
        MENUITEM "I&nsert Object...",       IDM_INSERTOBJECT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Card",                   IDM_CARDVIEW
        MENUITEM "&List",                   IDM_LISTVIEW
    END
    POPUP "&Card"
    BEGIN
        MENUITEM "&Add...\tF7",             IDM_ADD
        MENUITEM "&Delete",                 IDM_DELETE
        MENUITEM "Du&plicate",              IDM_DUPLICATE
        MENUITEM "Au&todial...\tF5",        IDM_AUTODIAL
    END
    POPUP "&Search"
    BEGIN
        MENUITEM "&Go To...\tF4",           IDM_GOTO
        MENUITEM "&Find...",                IDM_FIND
        MENUITEM "Find &Next\tF3",          IDM_FINDNEXT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents",               IDM_HELPCONTENTS
        MENUITEM "&Search for Help On...",  IDM_HELPSEARCH
        MENUITEM "&How to Use Help",        IDM_HELPHELP
        MENUITEM SEPARATOR
        MENUITEM "&About Cardfile...",      IDM_ABOUT
    END
END

IDA_MAIN ACCELERATORS
BEGIN
    VK_INSERT,  IDM_COPY,           VIRTKEY, CONTROL
    VK_F1,      IDM_HELPCONTENTS,   VIRTKEY
    VK_F3,      IDM_FINDNEXT,       VIRTKEY
    VK_F4,      IDM_GOTO,           VIRTKEY
    VK_F5,      IDM_AUTODIAL,       VIRTKEY
    VK_F6,      IDM_INDEX,          VIRTKEY
    VK_F7,      IDM_ADD,            VIRTKEY
    VK_BACK,    IDM_UNDO,           VIRTKEY, ALT
    "Z",        IDM_UNDO,           VIRTKEY, CONTROL
    "X",        IDM_CUT,            VIRTKEY, CONTROL
    "C",        IDM_COPY,           VIRTKEY, CONTROL
    "V",        IDM_PASTE,          VIRTKEY, CONTROL
END

