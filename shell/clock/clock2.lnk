# wlink directives for the Windows 2.x build of CLOCK.EXE: fixed
# segments, as Program Manager's 2.x build (shell/progman/progman2.lnk)
format windows
option quiet
option start=start
option stack=8k
option heapsize=4k
option description 'w16 Clock'
segment class 'CODE' fixed preload
segment class 'DATA' fixed preload
library windows.lib
