/*
 * commdlg.rc - w16 COMMDLG.DLL's resources.
 *
 * The dialog layouts, control IDs and styles and the strings are Windows
 * 3.1's COMMDLG's (format facts read from its resources, tools/nedlg.py;
 * applications that bring their own templates rely on the IDs, and the
 * dialogs must look the same). The pictures are w16's own
 * (tools/mkcdart.py).
 */
#include <windows.h>
#include "cdlgs.h"

#define CD_COMBO        "ComboBox"
#define CD_LIST         "ListBox"
#define DLG_STYLE       0x80C800C0L
#define DLG_FONTSTMT    FONT 8, "Helv"

BMP_DRIVES      BITMAP  "drives.bmp"
BMP_FONTTYPE    BITMAP  "fonttype.bmp"
BMP_CROSS       BITMAP  "cross.bmp"
BMP_ARROW       BITMAP  "arrow.bmp"
ICO_PORTRAIT    ICON    "portrait.ico"
ICO_LANDSCAPE   ICON    "landscape.ico"

DLG_OPEN DIALOG 36, 24, 264, 134
