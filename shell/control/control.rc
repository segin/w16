/* control.rc - w16 Control Panel resources. The menu and the strings are
   the original's plain UI labels (Windows 3.1 CONTROL.EXE, observed with
   tools/resdump.py); the applet commands are inserted at run time. */
#include <windows.h>
#include "control.h"

IDI_CONTROL ICON "control.ico"

IDM_CONTROL MENU
BEGIN
    POPUP "&Settings"
    BEGIN
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents", IDM_HELPCONTENTS
        MENUITEM "&Search for Help On...", IDM_HELPSEARCH
        MENUITEM "&How to Use Help", IDM_HELPHELP
        MENUITEM SEPARATOR
        MENUITEM "&About Control Panel...", IDM_ABOUT
    END
END

IDA_CONTROL ACCELERATORS
BEGIN
    VK_F1, IDM_HELPAPPLET, VIRTKEY
END

STRINGTABLE
BEGIN
    IDS_TITLE,   "Control Panel"
    IDS_LOADING, "Loading "
    IDS_NOMEM,   "Not enough memory available for this task.\n\nQuit one or more applications to increase available memory, and then try again."
    IDS_NOCPL,   "Cannot find the Control Panel components (files with .CPL extension).\n\n Verify that they are installed in your Windows SYSTEM directory."
    IDS_ABOUT,   "Control Panel"
END
