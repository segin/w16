/* Fonts, Ports and their dialogs: positions, sizes, IDs and styles measured
   on Windows 3.1 from its window dumps (SNAP "dump"/"info": pixels / base
   units 7 x 13 of 8-point Helv; a list box shows one pixel bigger all
   round, an edit control without WS_BORDER in its style); the dialogs'
   own resource IDs are w16's. ARCHITECTURE.md 14.3. */
DLG_FONTS DIALOG 8, 14, 246, 188
STYLE 0x80C800C0
CAPTION "Fonts"
FONT 8, "Helv"
BEGIN
    CONTROL "Installed &Fonts:", -1, "static", 0x50020000, 4, 2, 74, 9
    CONTROL "", IDC_FN_LIST, "listbox", 0x50A11803, 4, 12, 181, 48
    CONTROL "&Sample", -1, "static", 0x50020000, 4, 71, 66, 9
    CONTROL "", IDC_FN_SAMPLE, "listbox", 0x50A11021, 4, 82, 181, 56
    CONTROL "Cancel", IDOK, "button", 0x50030001, 190, 6, 50, 14
    CONTROL "&Remove", IDC_FN_REMOVE, "button", 0x58030000, 190, 26, 50, 14
    CONTROL "&Add...", IDC_FN_ADD, "button", 0x50030000, 190, 43, 50, 14
    CONTROL "&TrueType...", IDC_FN_TRUETYPE, "button", 0x50030000, 190, 60, 50, 14
    CONTROL "&Help", IDC_HELP, "button", 0x50030000, 190, 77, 50, 14
    CONTROL "", IDC_FN_TEXT, "static", 0x50020001, 5, 142, 179, 26
    CONTROL "", IDC_FN_SIZE, "static", 0x50020000, 5, 172, 150, 10
END
