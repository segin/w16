/* main.rc - w16 MAIN.CPL resources. Dialog layouts follow the Windows 3.1
   MAIN.CPL dialog templates (positions, IDs, styles: format facts read
   with tools/resdump.py); the labels are the original's plain UI text;
   user-facing "Windows" reads "w16" (ARCHITECTURE.md 3, branding); the
   icons are w16's own (tools/cplicons.py). */
#include <windows.h>
#include "maincpl.h"

IDI_COLOR    ICON "color.ico"
IDI_FONTS    ICON "fonts.ico"
IDI_PORTS    ICON "ports.ico"
IDI_MOUSE    ICON "mouse.ico"
IDI_DESKTOP  ICON "desktop.ico"
IDI_KEYBOARD ICON "keyboard.ico"
IDI_PRINTERS ICON "printers.ico"
IDI_INTL     ICON "intl.ico"
IDI_DATETIME ICON "datetime.ico"

STRINGTABLE
BEGIN
    IDS_NOMEM,          "Not enough memory available for this task.\n\nQuit one or more applications to increase available memory, and then try again."
    IDS_CONTROLPANEL,   "Control Panel"
    IDS_NAME_COLOR,     "&Color"
    IDS_NAME_PRINTERS,  "&Printers"
    IDS_NAME_FONTS,     "&Fonts"
    IDS_NAME_INTL,      "&International"
    IDS_NAME_PORTS,     "P&orts"
    IDS_NAME_KEYBOARD,  "&Keyboard"
    IDS_NAME_MOUSE,     "&Mouse"
    IDS_NAME_DATETIME,  "Date/&Time"
    IDS_NAME_DESKTOP,   "&Desktop"
    600, "Changes the w16 screen colors"
    601, "Installs and removes printers, and sets printing options"
    602, "Adds and removes fonts and sets TrueType options"
    603, "Specifies international settings"
    604, "Specifies communications settings for serial ports"
    605, "Specifies the keyboard repeat rate and delay"
    606, "Changes settings for your mouse"
    607, "Changes the date and time of your computer's clock"
    608, "Changes the look of your desktop"
    IDS_NOTYET,         "This applet is not part of w16 yet."
    IDS_CLOSE,          "Close"
    IDS_RS_TRUETYPE,    "Your TrueType setting has changed.\n\nYou will need to quit and restart w16 so that the new setting(s) can take effect."
    IDS_RS_COM,         "Your COM Port settings have changed.\n\nYou will need to quit and restart w16 so that the new setting(s) can take effect."
    IDS_FN_NONE,        "No fonts are selected."
    IDS_FN_SCREEN,      "This is a screen or plotter font."
    IDS_FN_TRUETYPE,    "This is a scalable TrueType font that can be displayed on the screen and printed on your printer."
    IDS_FN_MANY,        "w16 cannot display samples of more than one font at a time."
    IDS_FN_SIZE,        "The size of the font on the disk is:  %ld KB."
    IDS_FN_REMOVEQ,     "Are you sure you want to remove the %s font?"
    IDS_FN_INSTALLED,   "The %s font is already installed.\n\nTo install a new version, first remove the old version."
    IDS_FN_NOTFOUND,    "No fonts found."
    IDS_ELEMENT + 0, "Desktop"
    IDS_ELEMENT + 1, "Application Workspace"
    IDS_ELEMENT + 2, "Window Background"
    IDS_ELEMENT + 3, "Window Text"
    IDS_ELEMENT + 4, "Menu Bar"
    IDS_ELEMENT + 5, "Menu Text"
    IDS_ELEMENT + 6, "Active Title Bar"
    IDS_ELEMENT + 7, "Inactive Title Bar"
    IDS_ELEMENT + 8, "Active Title Bar Text"
    IDS_ELEMENT + 9, "Active Border"
    IDS_ELEMENT + 10, "Inactive Border"
    IDS_ELEMENT + 11, "Window Frame"
    IDS_ELEMENT + 12, "Scroll Bars"
    IDS_ELEMENT + 13, "Button Face"
    IDS_ELEMENT + 14, "Button Shadow"
    IDS_ELEMENT + 15, "Button Text"
    IDS_ELEMENT + 16, "Disabled Text"
    IDS_ELEMENT + 17, "Highlight"
    IDS_ELEMENT + 18, "Highlighted Text"
    IDS_ELEMENT + 19, "Inactive Title Bar Text"
    IDS_ELEMENT + 20, "Button Highlight"
    IDS_SAMPLE_ACTIVE,  "Active"
    IDS_SAMPLE_INACTIVE, "Inactive"
    IDS_SAMPLE_MENU,    "File  Edit"
    IDS_SAMPLE_WINTEXT, "Window Text"
    IDS_SAMPLE_DISABLED, "Disabled"
    IDS_SAMPLE_HILIGHTED, "Highlighted"
    IDS_DEFAULT_SCHEME, "w16 Default"
    IDS_SCHEME_NOREMOVE, "Cannot remove the %s color scheme."
    IDS_SAMPLE_OK,      "OK"
    IDS_SCHEME_DEFAULT, "You cannot change the w16 Default color scheme.\n\nSpecify a new name for the color scheme."
    IDS_SCHEME_EQUAL,   "The scheme name cannot include an equal sign (=)."
    IDS_SCHEME_BRACKET, "The scheme name cannot include left or right brackets ([ ])."
    IDS_SCHEME_BLANK,   "The scheme name cannot be blank."
    IDS_SCHEME_REMOVE,  "Are you sure you want to remove the %s color scheme?"
    IDS_DK_REMOVEPAT,   "Are you sure you want to remove the %s pattern?"
    IDS_DK_GRAN,        "Grid Granularity entry must be between %d and %d."
    IDS_DK_BORDER,      "Specify a value for the Border Width between %d and %d."
    IDS_DK_SPACING,     "Specify a value for Icon Spacing between %d and %d."
    IDS_DK_DELAY,       "Specify a value for the Screen Saver Delay between %d and %d."

END

