DLG_PORTSET DIALOG 8, 10, 192, 83
STYLE 0x80C800C0
CAPTION "Settings for COM%d:"
FONT 8, "Helv"
BEGIN
    CONTROL "&Baud Rate:", -1, "static", 0x50020000, 6, 7, 46, 9
    CONTROL "", IDC_PT_BAUD, "combobox", 0x50230202, 55, 5, 44, 54
    CONTROL "&Data Bits:", -1, "static", 0x50020000, 6, 22, 51, 8
    CONTROL "", IDC_PT_DATA, "combobox", 0x50230203, 55, 20, 44, 54
    CONTROL "&Parity:", -1, "static", 0x50020000, 6, 37, 39, 8
    CONTROL "", IDC_PT_PARITY, "combobox", 0x50230203, 55, 35, 44, 54
    CONTROL "&Stop Bits:", -1, "static", 0x50020000, 6, 53, 54, 8
    CONTROL "", IDC_PT_STOP, "combobox", 0x50230203, 55, 50, 44, 54
    CONTROL "&Flow Control:", -1, "static", 0x50020000, 6, 67, 54, 8
    CONTROL "", IDC_PT_FLOW, "combobox", 0x50230203, 55, 65, 65, 54
    CONTROL "OK", IDOK, "button", 0x50030001, 135, 6, 50, 14
    CONTROL "Cancel", IDCANCEL, "button", 0x50030000, 135, 23, 50, 14
    CONTROL "&Advanced...", IDC_PT_ADVANCED, "button", 0x50030000, 135, 43, 50, 14
    CONTROL "&Help", IDC_HELP, "button", 0x50030000, 135, 60, 50, 14
END
DLG_PORTADV DIALOG 8, 10, 205, 61
STYLE 0x80C800C0
CAPTION "Advanced Settings for COM%d:"
FONT 8, "Helv"
BEGIN
    CONTROL "&Base I/O Port Address:", -1, "static", 0x50020000, 6, 6, 79, 8
    CONTROL "", IDC_PT_BASE, "combobox", 0x50230202, 86, 4, 60, 54
    CONTROL "&Interrupt Request Line (IRQ):", -1, "static", 0x50020000, 6, 24, 115, 8
    CONTROL "", IDC_PT_IRQ, "combobox", 0x50230203, 86, 34, 60, 54
    CONTROL "OK", IDOK, "button", 0x50030001, 156, 3, 40, 14
    CONTROL "Cancel", IDCANCEL, "button", 0x50030000, 156, 21, 40, 14
    CONTROL "&Help", IDC_HELP, "button", 0x50030000, 156, 41, 40, 14
END
