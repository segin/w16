# wlink directives for MMSYSTEM.DLL (shell/mmsystem/; ARCHITECTURE.md 23).
# Names, ordinals and residency are those of Windows 3.1's MMSYSTEM
# (tools/neinfo.py): WEP and DRIVERPROC resident. Code and data fixed:
# the interrupt stack, DriverCallback, the timer services and their data
# are used at interrupt time.
format windows dll
option modname=MMSYSTEM
option description 'w16 multimedia system library'
option start=mm_libentry
option quiet
option map
option heapsize=2048
option alignment=16
segment type code fixed preload
segment type data fixed preload
library windows.lib
import K_GETCURRENTTASK KERNEL.36
export WEP.1 resident
export SNDPLAYSOUND.2
export MMSYSTEMGETVERSION.5
export DRIVERPROC.6=MMDRIVERPROC resident
export OUTPUTDEBUGSTR.30
export DRIVERCALLBACK.31
export STACKENTER.32
export STACKLEAVE.33
export MMDRVINSTALL.34
