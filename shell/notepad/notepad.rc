/*
 * notepad.rc - w16 Notepad resources.
 *
 * The menu, accelerators, messages and the Page Setup and Printing
 * dialogs match Windows 3.1's Notepad as observed (its resources read as
 * data with tools/nerdump.py, its windows with SNAP). Command, control and
 * string IDs are the original's. The icon is our own.
 */
#include <windows.h>
#include "notepad.h"

IDI_NOTEPAD ICON "notepad.ico"

IDM_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New",                    IDM_NEW
        MENUITEM "&Open...",                IDM_OPEN
        MENUITEM "&Save",                   IDM_SAVE
        MENUITEM "Save &As...",             IDM_SAVEAS
        MENUITEM "&Print",                  IDM_PRINT
        MENUITEM "Page Se&tup...",          IDM_PAGESETUP
        MENUITEM "P&rint Setup...",         IDM_PRINTSETUP
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                   IDM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",           IDM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",            IDM_CUT
        MENUITEM "&Copy\tCtrl+C",           IDM_COPY
        MENUITEM "&Paste\tCtrl+V",          IDM_PASTE
        MENUITEM "De&lete\tDel",            IDM_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Select &All",             IDM_SELECTALL
        MENUITEM "Time/&Date\tF5",          IDM_TIMEDATE
        MENUITEM SEPARATOR
        MENUITEM "&Word Wrap",              IDM_WORDWRAP
    END
    POPUP "&Search"
    BEGIN
        MENUITEM "&Find...",                IDM_FIND
        MENUITEM "Find &Next\tF3",          IDM_FINDNEXT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents",               IDM_HELPCONTENTS
        MENUITEM "&Search for Help on...",  IDM_HELPSEARCH
        MENUITEM "&How to Use Help",        IDM_HELPHELP
        MENUITEM SEPARATOR
        MENUITEM "&About Notepad...",       IDM_ABOUT
    END
END

/* observed (the original's MAINACC) */
MAINACC ACCELERATORS
BEGIN
    VK_INSERT,  IDM_COPY,           VIRTKEY, CONTROL
    VK_F1,      IDM_HELPCONTENTS,   VIRTKEY
    VK_F3,      IDM_FINDNEXT,       VIRTKEY
    VK_F5,      IDM_TIMEDATE,       VIRTKEY
    VK_BACK,    IDM_UNDO,           VIRTKEY, ALT
    "^Z",       IDM_UNDO
    "^X",       IDM_CUT
    "^C",       IDM_COPY
    "^V",       IDM_PASTE
END

STRINGTABLE
BEGIN
    IDS_CANTOPEN,       "Cannot open the %% file.\n\nMake sure a disk is in the drive you specified."
    IDS_CREATENEW,      "Cannot find the %% file.\n\nDo you want to create a new file?"
    IDS_REPLACE,        "The %% file already exists.\n\nDo you want to overwrite it?"
    IDS_CHANGED,        "The text in the %% file has changed.\n\nDo you want to save the changes?"
    IDS_UNTITLED,       "(Untitled)"
    IDS_TITLEPREFIX,    "Notepad - "
    IDS_CANTFIND,       "Cannot find ""%%"""
    IDS_NOMEMORY,       "Not enough memory available to complete this operation. Quit one or more applications to increase available memory, and then try again."
    IDS_TOOLARGE,       "The %% file is too large for Notepad.\n\nUse another editor to edit the file."
    IDS_APPNAME,        "Notepad"
    IDS_PASTELONG,      "The Clipboard line is too long to paste.\n\nCopy and paste smaller portions of the line."
    IDS_DISKFULL,       "Not enough disk space to save the %% file.\n\nDelete one or more files to increase available disk space, or save the file to a different disk."
    IDS_BADFORMAT,      "The %% file is not in the correct format for use with Notepad.\n\nCreate a new file or try opening a different file."
    IDS_EMPTYDELETE,    "%%\nThis file is empty and will be deleted. This file cannot be saved because it is empty."
    IDS_NOTEXT,         "You have not entered any text to be saved. Type some text, and then try again."
    IDS_CANTPRINT,      "Cannot print the %% file. Be sure that your printer is connected properly and use Control Panel to verify that the printer is configured properly."
    IDS_BADNAME,        "Not a valid file name."
    /* sic: the original's text lacks the V */
    IDS_BADNAME2,       "The filename %% is not valid.\nerify that the filename is no longer than 8 characters, followed by a period and an extension."
    IDS_PRINTDISK,      "Not enough disk space to print the %% file.\nDelete one or more files to increase available disk space, and then try again."
    IDS_PRINTMEM,       "Not enough memory to print.\n\nQuit one or more applications to increase available memory, and then try again."
    IDS_CANTCREATE,     "Cannot create the %% file.\n\nMake sure that the path and filename are correct."
    IDS_WRAPLARGE,      "Cannot carry out the Word Wrap command because there is too much text in the file."
    IDS_FILTERSPEC,     "\\*.TXT"
    IDS_HELPFILE,       "notepad.hlp"
    IDS_BADMARGIN,      "The Margin values are not correct. Either they are not numeric characters or they don't fit the dimensions of the page. Try either entering a number or decreasing the margins."
    IDS_HEADER,         "&f"
    IDS_FOOTER,         "Page &p"
    IDS_LEFT,           ".75"
    IDS_RIGHT,          ".75"
    IDS_TOP,            "1"
    IDS_BOTTOM,         "1"
    IDS_HFCODES,        "fFpPtTdDcCrRlL"
    IDS_PRINTOPEN,      "Cannot open the %% file.\n\nCannot print the file because it can't be found or is currently being used by another application. Be sure that the path and filename are correct, or wait until the application is finished, and then try again."
    IDS_FILTERTEXT,     "Text Files (*.TXT)"
    IDS_FILTERALL,      "All Files (*.*)"
    IDS_OPENTITLE,      "Open"
    IDS_SAVETITLE,      "Save As"
    IDS_QUERYEND,       "You cannot quit Windows because the Save As dialog\nbox in Notepad is open. Switch to Notepad, close this\ndialog box, and then try quitting Windows again."
    IDS_NODRIVER,       "Cannot load the driver for your printer.\nThere may not be enough memory, or the printer-driver file is missing.  \n\nReinstall your printer, or quit one or more applications to increase available memory, and then try again."
END

/* Page Setup: the original's template 14 */
IDD_PAGESETUP DIALOG 10, 10, 162, 95
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Page Setup"
FONT 8, "Helv"
BEGIN
    LTEXT           "&Header:", -1, 7, 6, 37, 10
    EDITTEXT        IDC_HEADER, 45, 6, 60, 12, ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "&Footer:", -1, 7, 25, 33, 10
    EDITTEXT        IDC_FOOTER, 45, 25, 60, 12, ES_AUTOHSCROLL | WS_GROUP
    GROUPBOX        "Margins", -1, 5, 42, 150, 49
    LTEXT           "&Left:", -1, 12, 56, 25, 10
    EDITTEXT        IDC_LEFT, 36, 54, 35, 12, ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "&Right:", -1, 80, 56, 25, 10
    EDITTEXT        IDC_RIGHT, 110, 55, 35, 12, ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "&Top:", -1, 12, 73, 25, 10
    EDITTEXT        IDC_TOP, 35, 73, 35, 12, ES_AUTOHSCROLL | WS_GROUP
    LTEXT           "&Bottom:", -1, 80, 74, 30, 10
    EDITTEXT        IDC_BOTTOM, 110, 73, 35, 12, ES_AUTOHSCROLL | WS_GROUP
    DEFPUSHBUTTON   "OK", IDOK, 115, 3, 40, 16, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 115, 22, 40, 16, WS_GROUP
END

/* Printing: the original's template 12 */
IDD_PRINTING DIALOG 20, 20, 90, 64
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Notepad"
FONT 8, "Helv"
BEGIN
    DEFPUSHBUTTON   "Cancel", IDCANCEL, 29, 44, 32, 14, WS_GROUP
    CTEXT           "Now Printing", -1, 0, 8, 90, 8
    CTEXT           "", IDC_PRINTFILE, 0, 18, 90, 8, SS_NOPREFIX
END

