/*
 * pifedit.rc - w16 PIF Editor's resources (ARCHITECTURE.md 15.11). The
 * menu, dialogs and texts reproduce Windows 3.1's PIF Editor as observed
 * running (SNAP dumps and screenshots, probes PE1-PE18; dialog templates
 * computed from the dumped control rectangles), never read from its file;
 * "w16" where 3.1 says "Windows" for the running system (ARCHITECTURE.md
 * 3). The icon is w16's own (tools/mkpificon.py).
 */
#include <windows.h>
#include "pifedit.h"

IDI_PIFEDIT ICON "pifedit.ico"

MENU_PIFEDIT MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New", IDM_NEW
        MENUITEM "&Open...", IDM_OPEN
        MENUITEM "&Save", IDM_SAVE
        MENUITEM "Save &As...", IDM_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Mode"
    BEGIN
        MENUITEM "&Standard", IDM_STANDARD
        MENUITEM "&386 Enhanced", IDM_ENHANCED
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents", IDM_HELPCONTENTS
        MENUITEM "&Search for Help on...", IDM_HELPSEARCH
        MENUITEM SEPARATOR
        MENUITEM "&Standard Options", IDM_HELPSTD
        MENUITEM "&386 Enhanced Options", IDM_HELPENH
        MENUITEM "A&dvanced Options", IDM_HELPADV
        MENUITEM SEPARATOR
        MENUITEM "&How to Use Help", IDM_HELPHELP
        MENUITEM SEPARATOR
        MENUITEM "&About PIF Editor...", IDM_ABOUT
    END
END

/* the views: child dialogs (PE1 Standard, PE2 386 Enhanced) */
