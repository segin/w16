IDM_MAIN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New...",                     IDM_NEW
        MENUITEM "&Open\tEnter",                IDM_OPEN
        MENUITEM "&Move...\tF7",                IDM_MOVE
        MENUITEM "&Copy...\tF8",                IDM_COPY
        MENUITEM "&Delete\tDel",                IDM_DELETE
        MENUITEM "&Properties...\tAlt+Enter",   IDM_PROPERTIES
        MENUITEM SEPARATOR
        MENUITEM "&Run...",                     IDM_RUN
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Auto Arrange",               IDM_AUTOARRANGE
        MENUITEM "&Minimize on Use",            IDM_MINONRUN
        MENUITEM "&Save Settings on Exit",      IDM_SAVESETTINGS
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Cascade\tShift+F5",          IDM_CASCADE
        MENUITEM "&Tile\tShift+F4",             IDM_TILE
        MENUITEM "&Arrange Icons",              IDM_ARRANGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents",                   IDM_HELPCONTENTS
        MENUITEM "&Search for Help on...",      IDM_HELPSEARCH
        MENUITEM SEPARATOR
        MENUITEM "&How to Use Help",            IDM_HELPHELP
        MENUITEM "&Windows Tutorial",           IDM_TUTORIAL
        MENUITEM SEPARATOR
        MENUITEM "&About Program Manager...",   IDM_ABOUT
    END
END

IDA_MAIN ACCELERATORS
BEGIN
    VK_RETURN,  IDM_OPEN,           VIRTKEY
    VK_F7,      IDM_MOVE,           VIRTKEY
    VK_F8,      IDM_COPY,           VIRTKEY
    VK_DELETE,  IDM_DELETE,         VIRTKEY
    VK_RETURN,  IDM_PROPERTIES,     VIRTKEY, ALT
    VK_F5,      IDM_CASCADE,        VIRTKEY, SHIFT
    VK_F4,      IDM_TILE,           VIRTKEY, SHIFT
END

STRINGTABLE
BEGIN
    IDS_APPNAME,        "Program Manager"
    IDS_NOTYET,         "This command is not implemented yet."
    IDS_EXECFAIL,       "Cannot run program or open document: %s"
    IDS_EXIT,           "E&xit"
    IDS_EXITWINDOWS,    "E&xit Windows..."
    IDS_DELETE,         "Delete"
    IDS_DELITEM,        "Are you sure you want to delete the item '%s'?"
    IDS_DELGROUP,       "Are you sure you want to delete the group '%s'?"
    IDS_NOGROUP,        "There is no program group to add the item to."
    IDS_HOTKEYNONE,     "None"
    IDS_HOTKEYPREFIX,   "Ctrl + Alt + "
    IDS_CANTWRITE,      "Cannot write the group file %s."
    IDS_DLGFAIL,        "The dialog box could not be opened."
    IDS_MOVETITLE,      "Move Program Item"
    IDS_COPYTITLE,      "Copy Program Item:"
    IDS_MOVELABEL,      "Move Program Item:"
    IDS_COPYLABEL,      "Copy Program Item:"
END

/* New Program Object (observed: 162 x 63 units; IDs 99/116/117/1/2/126) */
IDD_NEW DIALOG 23, 20, 162, 63
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "New Program Object"
#ifndef W16_WIN2
FONT 8, "MS Sans Serif"
#endif
BEGIN
    GROUPBOX        "New", IDC_STATIC, 9, 6, 95, 41, WS_GROUP
    CONTROL         "Program &Group", IDC_NEWGROUP, "Button",
                    PM_RADIO | WS_GROUP, 16, 16, 82, 12
    CONTROL         "Program &Item", IDC_NEWITEM, "Button",
                    PM_RADIO | WS_TABSTOP, 16, 29, 82, 12
    DEFPUSHBUTTON   "OK", IDOK, 115, 6, 40, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 115, 23, 40, 14, WS_GROUP
    PUSHBUTTON      "&Help", IDC_HELPBTN, 115, 43, 40, 14, WS_GROUP
END

/* Program Group Properties (observed: 226 x 63 units at (23, 21)) */
IDD_GROUPPROPS DIALOG 23, 21, 226, 63
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Program Group Properties"
#ifndef W16_WIN2
FONT 8, "MS Sans Serif"
#endif
BEGIN
    CONTROL         "&Description:", IDC_STATIC, "Static", SS_LEFT, 5, 9, 45, 10
    EDITTEXT        IDC_DESC, 54, 7, 119, 12, ES_AUTOHSCROLL
    CONTROL         "&Group File:", IDC_STATIC, "Static", SS_LEFT, 5, 24, 45, 10
    EDITTEXT        IDC_GROUPFILE, 54, 22, 119, 12, ES_AUTOHSCROLL | ES_OEMCONVERT
    DEFPUSHBUTTON   "OK", IDOK, 180, 6, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 180, 23, 40, 14
    PUSHBUTTON      "&Help", IDC_HELPBTN, 180, 43, 40, 14
END

#ifndef W16_WIN2
/* Program Item Properties (observed: 251 x 97 units) */
IDD_ITEMPROPS DIALOG 23, 20, 251, 97
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Program Item Properties"
#ifndef W16_WIN2
FONT 8, "MS Sans Serif"
#endif
BEGIN
    CONTROL         "&Description:", IDC_STATIC, "Static", SS_LEFT, 5, 10, 60, 10
    EDITTEXT        IDC_DESC, 77, 6, 105, 12, ES_AUTOHSCROLL
    CONTROL         "&Command Line:", IDC_STATIC, "Static", SS_LEFT, 5, 23, 67, 10
    EDITTEXT        IDC_CMDLINE, 77, 20, 105, 12, ES_AUTOHSCROLL | ES_OEMCONVERT
    CONTROL         "&Working Directory:", IDC_WORKDIR_LABEL, "Static", SS_LEFT, 5, 36, 71, 10
    EDITTEXT        IDC_WORKDIR, 77, 34, 105, 12, ES_AUTOHSCROLL | ES_OEMCONVERT
    CONTROL         "&Shortcut Key:", IDC_STATIC, "Static", SS_LEFT, 5, 50, 63, 10
    CONTROL         "", IDC_HOTKEY, "pmhotkey", WS_BORDER | WS_TABSTOP, 77, 49, 105, 12
    CONTROL         "&Run Minimized", IDC_ITEMMIN, "Button",
                    PM_CHECK | WS_TABSTOP, 77, 65, 111, 12
    DEFPUSHBUTTON   "OK", IDOK, 191, 6, 55, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 191, 23, 55, 14
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 191, 43, 55, 14
    PUSHBUTTON      "Change &Icon...", IDC_CHANGEICON, 191, 60, 55, 14
    PUSHBUTTON      "&Help", IDC_HELPBTN, 191, 77, 55, 14
    CONTROL         "", IDC_ITEMICON, "Static", SS_ICON, 24, 65, 18, 20
END
#else
/* Windows 2.x: the system font is wider, so labels get more room */
IDD_ITEMPROPS DIALOG 23, 20, 251, 97
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Program Item Properties"
#ifndef W16_WIN2
FONT 8, "MS Sans Serif"
#endif
BEGIN
    CONTROL         "&Description:", IDC_STATIC, "Static", SS_LEFT, 5, 10, 76, 10
    EDITTEXT        IDC_DESC, 83, 6, 100, 12, ES_AUTOHSCROLL
    CONTROL         "&Command Line:", IDC_STATIC, "Static", SS_LEFT, 5, 23, 76, 10
    EDITTEXT        IDC_CMDLINE, 83, 20, 100, 12, ES_AUTOHSCROLL | ES_OEMCONVERT
    CONTROL         "&Working Directory:", IDC_WORKDIR_LABEL, "Static", SS_LEFT, 5, 36, 76, 10
    EDITTEXT        IDC_WORKDIR, 83, 34, 100, 12, ES_AUTOHSCROLL | ES_OEMCONVERT
    CONTROL         "&Shortcut Key:", IDC_STATIC, "Static", SS_LEFT, 5, 50, 76, 10
    CONTROL         "", IDC_HOTKEY, "pmhotkey", WS_BORDER | WS_TABSTOP, 83, 49, 100, 12
    CONTROL         "&Run Minimized", IDC_ITEMMIN, "Button",
                    PM_CHECK | WS_TABSTOP, 83, 65, 100, 12
    DEFPUSHBUTTON   "OK", IDOK, 191, 6, 55, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 191, 23, 55, 14
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 191, 43, 55, 14
    PUSHBUTTON      "Change &Icon...", IDC_CHANGEICON, 191, 60, 55, 14
    PUSHBUTTON      "&Help", IDC_HELPBTN, 191, 77, 55, 14
    CONTROL         "", IDC_ITEMICON, "Static", SS_ICON, 24, 65, 18, 20
END
#endif

/* observed: 210 x 81 units, controls 99/119/105/1/2/112/126 */
IDD_RUN DIALOG 23, 20, 210, 81
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Run"
#ifndef W16_WIN2
FONT 8, "MS Sans Serif"
#endif
BEGIN
    LTEXT           "&Command Line:", 99, 3, 12, 60, 10, WS_GROUP
    EDITTEXT        IDC_RUNCMD, 3, 23, 134, 12, ES_AUTOHSCROLL | ES_OEMCONVERT
    CONTROL         "Run &Minimized", IDC_RUNMIN, "Button",
                    PM_CHECK | WS_TABSTOP, 3, 42, 71, 12
    DEFPUSHBUTTON   "OK", IDOK, 165, 6, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 165, 23, 40, 14
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 165, 40, 40, 14
    PUSHBUTTON      "&Help", IDC_HELPBTN, 165, 61, 40, 14
END

/* Our own About box (the original's comes from SHELL.DLL's ShellAbout);
   same frame size, 220 x 158 units. */
IDD_ABOUT DIALOG 23, 20, 220, 158
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "About Program Manager"
#ifndef W16_WIN2
FONT 8, "MS Sans Serif"
#endif
BEGIN
#ifndef W16_WIN2
    ICON            IDI_PROGMAN, -1, 10, 5, 18, 20
#endif
    LTEXT           "w16 Program Manager", -1, 45, 5, 127, 10, SS_NOPREFIX
    LTEXT           "Version 3.1", -1, 45, 15, 100, 10, SS_NOPREFIX
    LTEXT           "A clean-room reimplementation, part of w16.", -1,
                    45, 25, 145, 20, SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 177, 5, 40, 14
END

/* Move/Copy Program Item (observed: 200 x 64 units, IDs 115/117/99/116/
   99/118/1/2/126; caption and first label set by the program) */
#ifndef W16_WIN2
IDD_MOVECOPY DIALOG 23, 20, 200, 64
#else
IDD_MOVECOPY DIALOG 23, 20, 200, 90
#endif
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Move Program Item"
#ifndef W16_WIN2
FONT 8, "MS Sans Serif"
#endif
BEGIN
    CONTROL         "Move Program Item:", IDC_MC_LABEL, "Static", SS_LEFT, 5, 3, 70, 10
    CONTROL         "", IDC_MC_ITEM, "Static", SS_LEFTNOWORDWRAP | SS_NOPREFIX, 80, 3, 73, 10
    CONTROL         "From Program Group:", IDC_STATIC, "Static", SS_LEFT, 5, 13, 74, 10
    CONTROL         "", IDC_MC_GROUP, "Static", SS_LEFTNOWORDWRAP | SS_NOPREFIX, 80, 13, 73, 10
    CONTROL         "&To Group:", IDC_STATIC, "Static", SS_LEFT, 5, 25, 45, 10
#ifndef W16_WIN2
    CONTROL         "", IDC_MC_TO, "ComboBox",
                    CBS_DROPDOWNLIST | CBS_SORT | CBS_HASSTRINGS | WS_TABSTOP, 5, 37, 130, 60
#else
    CONTROL         "", IDC_MC_TO, "ListBox",
                    LBS_SORT | WS_BORDER | WS_VSCROLL | WS_TABSTOP, 5, 37, 130, 48
#endif
    DEFPUSHBUTTON   "OK", IDOK, 154, 6, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 154, 23, 40, 14
    PUSHBUTTON      "&Help", IDC_HELPBTN, 154, 44, 40, 14
END

/* Exit Windows (observed: a system-modal dialog in the dialog font,
   centred on the screen; measured from screenshots, about 160 x 50
   units). Shown when Program Manager is the shell. */
IDD_EXITWIN DIALOG 0, 0, 160, 50
STYLE DS_MODALFRAME | DS_SYSMODAL | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Exit Windows"
#ifndef W16_WIN2
FONT 8, "MS Sans Serif"
#endif
BEGIN
    CONTROL         "", IDC_EXITICON, "Static", SS_ICON, 5, 5, 18, 20
    CONTROL         "This will end your Windows session.", IDC_STATIC, "Static",
                    SS_LEFT | SS_NOPREFIX, 30, 10, 125, 10
    DEFPUSHBUTTON   "OK", IDOK, 30, 30, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 90, 30, 40, 14
END
