    CONTROL         "&Command Line:", IDC_STATIC, "Static", SS_LEFT, 5, 23, 76, 10
    EDITTEXT        IDC_CMDLINE, 83, 20, 100, 12, ES_AUTOHSCROLL | ES_OEMCONVERT
    CONTROL         "&Working Directory:", IDC_WORKDIR_LABEL, "Static", SS_LEFT, 5, 36, 76, 10
    EDITTEXT        IDC_WORKDIR, 83, 34, 100, 12, ES_AUTOHSCROLL | ES_OEMCONVERT
    CONTROL         "&Shortcut Key:", IDC_STATIC, "Static", SS_LEFT, 5, 50, 76, 10
    CONTROL         "", IDC_HOTKEY, "pmhotkey", WS_BORDER | WS_TABSTOP, 83, 49, 100, 12
    CONTROL         "&Run Minimized", IDC_ITEMMIN, "Button",
                    PM_CHECK | WS_TABSTOP, 83, 65, 100, 12
    DEFPUSHBUTTON   "OK", IDOK, 191, 6, 55, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 191, 23, 55, 14
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 191, 43, 55, 14
    PUSHBUTTON      "Change &Icon...", IDC_CHANGEICON, 191, 60, 55, 14
    PUSHBUTTON      "&Help", IDC_HELPBTN, 191, 77, 55, 14
    CONTROL         "", IDC_ITEMICON, "pmicon", 0, 24, 65, 18, 20
END
#endif

/* observed: 210 x 81 units, controls 99/119/105/1/2/112/126 */
IDD_RUN DIALOG 23, 20, 210, 81
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Run"
#ifndef W16_WIN2
FONT 8, "MS Sans Serif"
#endif
BEGIN
    LTEXT           "&Command Line:", 99, 3, 12, 60, 10, WS_GROUP
    EDITTEXT        IDC_RUNCMD, 3, 23, 134, 12, ES_AUTOHSCROLL | ES_OEMCONVERT
    CONTROL         "Run &Minimized", IDC_RUNMIN, "Button",
                    PM_CHECK | WS_TABSTOP, 3, 42, 71, 12
    DEFPUSHBUTTON   "OK", IDOK, 165, 6, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 165, 23, 40, 14
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 165, 40, 40, 14
    PUSHBUTTON      "&Help", IDC_HELPBTN, 165, 61, 40, 14
END

/* The Windows 2.x build's About box (3.x uses SHELL's ShellAbout, as the
   original does). Laid out after ShellAbout's: the program's name and
   version, then the free memory. */
#ifdef W16_WIN2
IDD_ABOUT DIALOG 23, 20, 220, 96
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "About Program Manager"
BEGIN
    LTEXT           "w16 Program Manager", -1, 45, 8, 127, 10, SS_NOPREFIX
    LTEXT           "Version 3.1", -1, 45, 18, 100, 10, SS_NOPREFIX
    LTEXT           "A clean-room reimplementation, part of w16.", -1,
                    45, 28, 145, 20, SS_NOPREFIX
    LTEXT           "Windows 2.x", -1, 45, 56, 120, 10, SS_NOPREFIX
    LTEXT           "Memory:", -1, 45, 66, 60, 10, SS_NOPREFIX
    LTEXT           "", IDC_ABOUTMEM, 110, 66, 90, 10, SS_NOPREFIX
    DEFPUSHBUTTON   "OK", IDOK, 177, 8, 36, 14
END
#endif

/* Move/Copy Program Item (observed: 200 x 64 units, IDs 115/117/99/116/
   99/118/1/2/126; caption and first label set by the program) */
#ifndef W16_WIN2
IDD_MOVECOPY DIALOG 23, 20, 200, 64
#else
IDD_MOVECOPY DIALOG 23, 20, 200, 90
#endif
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Move Program Item"
#ifndef W16_WIN2
FONT 8, "MS Sans Serif"
#endif
BEGIN
    CONTROL         "Move Program Item:", IDC_MC_LABEL, "Static", SS_LEFT, 5, 3, 70, 10
    CONTROL         "", IDC_MC_ITEM, "Static", SS_LEFTNOWORDWRAP | SS_NOPREFIX, 80, 3, 73, 10
    CONTROL         "From Program Group:", IDC_STATIC, "Static", SS_LEFT, 5, 13, 74, 10
    CONTROL         "", IDC_MC_GROUP, "Static", SS_LEFTNOWORDWRAP | SS_NOPREFIX, 80, 13, 73, 10
    CONTROL         "&To Group:", IDC_STATIC, "Static", SS_LEFT, 5, 25, 45, 10
#ifndef W16_WIN2
    CONTROL         "", IDC_MC_TO, "ComboBox",
                    CBS_DROPDOWNLIST | CBS_SORT | CBS_HASSTRINGS | WS_TABSTOP, 5, 37, 130, 60
#else
    CONTROL         "", IDC_MC_TO, "ListBox",
                    LBS_SORT | WS_BORDER | WS_VSCROLL | WS_TABSTOP, 5, 37, 130, 48
#endif
    DEFPUSHBUTTON   "OK", IDOK, 154, 6, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 154, 23, 40, 14
    PUSHBUTTON      "&Help", IDC_HELPBTN, 154, 44, 40, 14
END

/* Exit Windows (observed: a system-modal dialog in the dialog font,
   centred on the screen; measured from screenshots, about 160 x 50
   units). Shown when Program Manager is the shell. */
IDD_EXITWIN DIALOG 0, 0, 160, 50
STYLE DS_MODALFRAME | DS_SYSMODAL | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Exit w16"
#ifndef W16_WIN2
FONT 8, "MS Sans Serif"
#endif
BEGIN
    CONTROL         "", IDC_EXITICON, "Static", SS_ICON, 5, 5, 18, 20
    CONTROL         "This will end your w16 session.", IDC_STATIC, "Static",
                    SS_LEFT | SS_NOPREFIX, 30, 10, 125, 10
    DEFPUSHBUTTON   "OK", IDOK, 30, 30, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 90, 30, 40, 14
END

/* Change Icon (observed: 222 x 82 units, at screen 152,135 over the
   item dialog; IDs 99/100/99/102/1/2/112/126; the list at 244,213 210x54;
   the icon list is an owner-drawn, multi-column list box with a
   horizontal scroll bar). Windows 2.x has neither owner-drawn nor
   multi-column list boxes: its build uses its own icon strip, pmiconlist
   (dialogs.c). */
IDD_CHGICON DIALOG 25, 22, 222, 82
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Change Icon"
#ifndef W16_WIN2
FONT 8, "MS Sans Serif"
#endif
BEGIN
    CONTROL         "&File Name:", IDC_STATIC, "Static", SS_LEFT, 5, 7, 43, 10
    EDITTEXT        IDC_ICONFILE, 50, 6, 120, 12, ES_AUTOHSCROLL | ES_OEMCONVERT
    CONTROL         "&Current Icon:", IDC_STATIC, "Static", SS_LEFT, 5, 22, 79, 10
#ifndef W16_WIN2
    CONTROL         "", IDC_ICONLIST, "ListBox",
                    LBS_NOTIFY | LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | LBS_MULTICOLUMN |
                    LBS_DISABLENOSCROLL | WS_BORDER | WS_HSCROLL | WS_TABSTOP, 50, 34, 119, 32
#else
    CONTROL         "", IDC_ICONLIST, "pmiconlist", WS_BORDER | WS_HSCROLL | WS_TABSTOP,
                    50, 34, 119, 32
#endif
    DEFPUSHBUTTON   "OK", IDOK, 178, 6, 40, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 178, 23, 40, 14
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 178, 43, 40, 14
    PUSHBUTTON      "&Help", IDC_HELPBTN, 178, 60, 40, 14
END

#ifdef W16_WIN2
/* Browse, for Windows 2.x (no COMMDLG): COMMDLG's Open dialog as observed
   on Windows 3.1 (its pixel layout halved into 2.x dialog units, and its
   control IDs), with our own folder tree and drop-down lists. */
IDD_BROWSE DIALOG 32, 10, 232, 113
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Browse"
BEGIN
    CONTROL         "File &Name:", 0x442, "Static", SS_LEFT, 6, 6, 80, 8
    EDITTEXT        0x480, 5, 14, 80, 12, ES_AUTOHSCROLL | ES_OEMCONVERT
    CONTROL         "", 0x460, "ListBox", LBS_SORT | LBS_NOTIFY | WS_VSCROLL | WS_BORDER |
                    WS_TABSTOP, 5, 29, 80, 55
    CONTROL         "&Directories:", -1, "Static", SS_LEFT, 97, 6, 80, 8
    CONTROL         "", 0x440, "Static", SS_LEFT | SS_NOPREFIX, 97, 16, 80, 8
    CONTROL         "", 0x461, "pmdirlist", WS_VSCROLL | WS_BORDER | WS_TABSTOP,
                    96, 29, 82, 55
    CONTROL         "List Files of &Type:", 0x441, "Static", SS_LEFT, 6, 87, 80, 8
    CONTROL         "", 0x470, "pmcombo", WS_TABSTOP, 5, 96, 80, 12
    CONTROL         "Dri&ves:", 0x443, "Static", SS_LEFT, 97, 87, 80, 8
    CONTROL         "", 0x471, "pmcombo", CBS_OWNERDRAWFIXED | WS_TABSTOP, 96, 96, 82, 12
    DEFPUSHBUTTON   "OK", IDOK, 184, 6, 44, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 184, 22, 44, 14
    PUSHBUTTON      "&Help", 0x40E, 184, 40, 44, 14
END
#endif
