/*
 * progman.rc - Program Manager resources.
 *
 * Menus, accelerators, and dialog layouts match Windows 3.1's Program
 * Manager as observed (SNAP.EXE screenshots and window dumps). Dialog
 * units follow from the observed pixel rectangles with the dialog font
 * (8 pt MS Sans Serif: base units 7 x 13 at 96 dpi). Control IDs are the
 * observed ones, and every dialog sits at (23, 20). Text that names
 * Microsoft products, the copyright, and all artwork are our own.
 */
#include <windows.h>
#include "progman.h"

/* Windows 2.x cannot read 3.x-format icons; the 2.x build has none yet
   (TODO: icons in the 2.x format), nor dialog fonts (3.0 and later). */
