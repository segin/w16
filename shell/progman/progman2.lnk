# wlink directives for the Windows 2.x build of PROGMAN.EXE. Real-mode
# Windows moves and discards segments; keeping them fixed avoids the
# bookkeeping that needs (and our code is small).
format windows
option quiet
option start=start
option stack=8k
option heapsize=16k
option description 'w16 Program Manager'
segment class 'CODE' fixed preload
segment class 'DATA' fixed preload
library windows.lib
