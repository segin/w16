/*
 * write.rc - w16 Write resources.
 *
 * Menus, accelerators, dialog layouts, control IDs and the plain UI
 * strings match Windows 3.1's Write as observed (its resource templates
 * read as data with tools/nerc.py, and SNAP.EXE screenshots). The icon is
 * our own (tools/mkwriteicon.py). Strings that name Microsoft products
 * are our own wording.
 */
#include <windows.h>
#include "write.h"

/* the original's dialogs: modal frame, popup, caption, system menu; the
   3.x build gives them the 8-point "Helv" font as the original does */
#define WR_DLGSTYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU

IDI_WRITE ICON "write.ico"

MW_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New", IDM_NEW
        MENUITEM "&Open...", IDM_OPEN
        MENUITEM "&Save", IDM_SAVE
        MENUITEM "Save &As...", IDM_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "&Print...", IDM_PRINT
        MENUITEM "P&rint Setup...", IDM_PRINTSETUP
        MENUITEM "R&epaginate...", IDM_REPAGINATE
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z", IDM_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X", IDM_CUT
        MENUITEM "&Copy\tCtrl+C", IDM_COPY
        MENUITEM "&Paste\tCtrl+V", IDM_PASTE
        MENUITEM "Paste Sp&ecial...", IDM_PASTESPECIAL
        MENUITEM "Paste &Link", IDM_PASTELINK
        MENUITEM SEPARATOR
        MENUITEM "Lin&ks...", IDM_LINKS
        MENUITEM "&Object...", IDM_OBJECT
        MENUITEM "&Insert Object...", IDM_INSERTOBJ
        MENUITEM SEPARATOR
        MENUITEM "&Move Picture", IDM_MOVEPICT
        MENUITEM "&Size Picture", IDM_SIZEPICT
    END
    POPUP "Fi&nd"
    BEGIN
        MENUITEM "&Find...", IDM_FIND
        MENUITEM "Repeat &Last Find\tF3", IDM_FINDAGAIN
        MENUITEM "R&eplace...", IDM_REPLACE
        MENUITEM SEPARATOR
        MENUITEM "&Go To Page...\tF4", IDM_GOTO
    END
    POPUP "&Character"
    BEGIN
        MENUITEM "Re&gular\tF5", IDM_REGULAR
        MENUITEM SEPARATOR
        MENUITEM "&Bold\tCtrl+B", IDM_BOLD
        MENUITEM "&Italic\tCtrl+I", IDM_ITALIC
        MENUITEM "&Underline\tCtrl+U", IDM_UNDERLINE
        MENUITEM "Su&perscript", IDM_SUPER
        MENUITEM "Subs&cript", IDM_SUB
        MENUITEM SEPARATOR
        MENUITEM "&Reduce Font", IDM_REDUCE
        MENUITEM "&Enlarge Font", IDM_ENLARGE
        MENUITEM SEPARATOR
        MENUITEM "&Fonts...", IDM_FONTS
    END
    POPUP "&Paragraph"
    BEGIN
        MENUITEM "&Normal", IDM_NORMAL
        MENUITEM SEPARATOR
        MENUITEM "&Left", IDM_LEFT
        MENUITEM "&Centered", IDM_CENTER
        MENUITEM "&Right", IDM_RIGHT
        MENUITEM "&Justified", IDM_JUSTIFY
        MENUITEM SEPARATOR
        MENUITEM "&Single Space", IDM_SINGLE
        MENUITEM "&1 1/2 Space", IDM_ONEHALF
        MENUITEM "&Double Space", IDM_DOUBLE
        MENUITEM SEPARATOR
        MENUITEM "&Indents...", IDM_INDENTS
    END
    POPUP "&Document"
    BEGIN
        MENUITEM "&Header...", IDM_HEADER
        MENUITEM "&Footer...", IDM_FOOTER
        MENUITEM SEPARATOR
        MENUITEM "&Ruler On", IDM_RULER
        MENUITEM "&Tabs...", IDM_TABS
        MENUITEM SEPARATOR
        MENUITEM "&Page Layout...", IDM_PAGELAYOUT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Contents", IDM_HELPCONTENTS
        MENUITEM "&Search for Help on...", IDM_HELPSEARCH
        MENUITEM "&How to Use Help", IDM_HELPHELP
        MENUITEM SEPARATOR
        MENUITEM "&About Write...", IDM_ABOUT
    END
END

/* observed (MW_ACCTB): F1 sends 62192 (F2F0h), which no menu item has
   (Help Index: WR11); F2 Copy (UNVERIFIED purpose, as observed), F3-F8
   as the menu shows */
MW_ACCTB ACCELERATORS
BEGIN
    VK_F1, IDM_HELPF1, VIRTKEY
    VK_F2, IDM_COPY, VIRTKEY
    VK_F3, IDM_FINDAGAIN, VIRTKEY
    VK_F4, IDM_GOTO, VIRTKEY
    VK_F5, IDM_REGULAR, VIRTKEY
    VK_F6, IDM_BOLD, VIRTKEY
    VK_F7, IDM_ITALIC, VIRTKEY
    VK_F8, IDM_UNDERLINE, VIRTKEY
    "^B", IDM_BOLD
    "^I", IDM_ITALIC
    "^U", IDM_UNDERLINE
    "^Z", IDM_UNDO
    "^X", IDM_CUT
    "^C", IDM_COPY
    "^V", IDM_PASTE
END

STRINGTABLE
BEGIN
    IDS_UNDO, "&Undo "
    IDS_EDITING, "Editing"
    IDS_FORMATTING, "Formatting"
    IDS_TYPING, "Typing"
    IDS_RULERON, "&Ruler On"
    IDS_RULEROFF, "&Ruler Off"
    IDS_HELPFILE, "WRITE.HLP"
    IDS_PAGE, "page"
    IDS_LOADING, "Loading..."
    IDS_REPLACEEXIST, "Replace Existing %s?"
    IDS_TEXTDOC, "Text document"
    IDS_WORDDOC, "Word for DOS document"
    IDS_OPENTITLE, "Open"
    IDS_SAVEASTITLE, "Save As"
    IDS_EXTWRI, "WRI"
    IDS_EXTDOC, "DOC"
    IDS_EXTTXT, "TXT"
    IDS_FLTTXT, "Text Files (*.TXT)"
    IDS_FLTWRI, "Write Files (*.WRI)"
    IDS_FLTDOC, "Word for DOS (*.DOC)"
    IDS_FLTDOCTXT, "Word for DOS/Txt Only (*.DOC)"
    IDS_FLTWRI30, "3.0 Write (*.WRI)"
    IDS_FLTALL, "All Files (*.*)"
    IDS_BACKUP, "&Backup"
    IDS_SEARCHDONE, "Search operation complete."
    IDS_NOTFOUND, "Text not found."
    IDS_NOREPLACE, "No replacements were made."
    IDS_CONVERTQ, "%s\nDo you want to convert this file to Write format?"
    IDS_READONLY, "The file is read-only.\n\nUse a different filename."
    IDS_CORRUPT, "This document is corrupt and cannot be accessed."
    IDS_BADNAME, "%s\nThis filename is not valid."
    IDS_CANTREAD, "%s\nCannot read this file.\n\nEither something has happened to the network or possibly the file has been renamed or moved."
    IDS_DAMAGED, "The document you are opening may be damaged. Write may not run correctly if this document is opened.\n\nDo you want open this document?"
    IDS_NOPAGE, "No such page."
    IDS_NOTNUMBER, "Not a valid number."
    IDS_FONTSIZE, "You can only specify a font size between 4 and 127 points."
    IDS_WHOLENUMBER, "You can only specify a whole number between 1 and 32767."
    IDS_BADMEASURE, "Measurement not in expected range.\n\nPlease enter a valid positive number."
    IDS_MEASUREPOS, "Measurement must be a number larger than zero."
    IDS_MARGINSBIG, "The margin values are too large and don't fit the dimensions of the page.\n\nEnter a smaller number to decrease the margins."
    IDS_NOTFOUNDFILE, "%s\nFile not found.\n\nPlease verify that the correct path and filename are given."
    IDS_SAVECHANGES, "%s\nThis document has changed.\n\nSave current changes?"
    IDS_NOMEMORY, "Not enough memory for Write to complete this operation.\n\nQuit one or more applications to increase available memory, and then try again."
    IDS_NOPATH, "Path does not exist.\n\nPlease verify that the correct path is given."
    IDS_CANTSAVE, "Cannot save file.\n\nMake sure that the file or disk is not damaged."
    IDS_PAGE1, "Page 1"
    IDS_WRITE, "Write"
    IDS_UNTITLED, "(Untitled)"
    IDS_HEADERNAME, "HEADER"
    IDS_FOOTERNAME, "FOOTER"
    IDS_INCH, "\""
    IDS_CM, " cm"
END

IDD_CONVERT DIALOG 22, 22, 220, 60
STYLE WR_DLGSTYLE
CAPTION "Write"
FONT 8, "Helv"
BEGIN
    ICON 32515, -1, 15, 8, 0, 0
    CONTROL "", 99, "Static", 0x50020001L, 35, 14, 180, 20
    CONTROL "&Convert", 1, "Button", 0x50030001L, 25, 39, 48, 14
    CONTROL "&No Conversion", 7, "Button", 0x50030000L, 81, 39, 65, 14
    CONTROL "Cancel", 2, "Button", 0x50030000L, 155, 39, 40, 14
END

IDD_PRINTING DIALOG 20, 20, 90, 64
STYLE WR_DLGSTYLE | WS_VISIBLE
CAPTION "Write"
FONT 8, "Helv"
BEGIN
    CONTROL "Now Printing", -1, "Static", 0x50020001L, 0, 8, 90, 8
    CONTROL "", 100, "Static", 0x50020081L, 0, 18, 90, 8
    CONTROL "Cancel", 2, "Button", 0x50030001L, 29, 44, 32, 14
END

IDD_REPAGINATE DIALOG 90, 100, 155, 45
STYLE WR_DLGSTYLE
CAPTION "Repaginate Document"
FONT 8, "Helv"
BEGIN
    CONTROL "Confirm Page &Breaks", 3, "Button", 0x50030002L, 5, 15, 100, 12
    CONTROL "OK", 1, "Button", 0x50030001L, 110, 5, 40, 14
    CONTROL "Cancel", 2, "Button", 0x50030000L, 110, 25, 40, 14
END

IDD_REPAGINATING DIALOG 15, 50, 94, 50
STYLE WR_DLGSTYLE | WS_VISIBLE
CAPTION "Write"
