    CONTROL "Cancel", 2, "Button", 0x50030001L, 27, 28, 40, 14
END

IDD_CONFIRMBREAK DIALOG 90, 120, 192, 50
STYLE WR_DLGSTYLE
CAPTION "Repaginating Document"
FONT 8, "Helv"
BEGIN
    CONTROL "Use up and down buttons", -1, "Static", 0x50020000L, 5, 5, 92, 8
    CONTROL "to move page break", -1, "Static", 0x50020000L, 5, 14, 72, 8
    CONTROL "if necessary,", -1, "Static", 0x50020000L, 5, 23, 52, 8
    CONTROL "then confirm.", -1, "Static", 0x50020000L, 5, 32, 52, 8
    CONTROL "&Up", 5, "Button", 0x50030000L, 102, 8, 40, 14
    CONTROL "&Down", 6, "Button", 0x50030000L, 102, 28, 40, 14
    CONTROL "&Confirm", 1, "Button", 0x50030001L, 147, 8, 40, 14
    CONTROL "Cancel", 2, "Button", 0x50030000L, 147, 28, 40, 14
END

IDD_KEEPBREAK DIALOG 90, 100, 135, 58
STYLE WR_DLGSTYLE
CAPTION "Repaginating Document"
FONT 8, "Helv"
BEGIN
    ICON 32515, -1, 5, 5, 0, 0
    CONTROL "Would you like to keep", -1, "Static", 0x50020000L, 30, 7, 92, 12
    CONTROL "this existing page break?", -1, "Static", 0x50020000L, 30, 19, 100, 12
    CONTROL "Cancel", 2, "Button", 0x50030000L, 7, 35, 35, 14
    CONTROL "&Keep", 1, "Button", 0x50030001L, 49, 35, 35, 14
    CONTROL "&Remove", 4, "Button", 0x50030000L, 91, 35, 35, 14
END

