/* tk12.rc - resources for TK12.EXE (tests/apps/tk12.c), the KERNEL
   resource probe: integer and named ids, predefined, user-defined integer
   and named types, and the memory options. */

/* RT_RCDATA (10), integer ids */
1 RCDATA LOADONCALL MOVEABLE DISCARDABLE { "Hello\0" }
2 RCDATA PRELOAD FIXED { "Preloaded resource, fixed.\0" }
3 RCDATA LOADONCALL MOVEABLE { "Moveable, not discardable.\0" }
4 RCDATA PRELOAD MOVEABLE DISCARDABLE { "Preloaded, discardable.\0" }
5 RCDATA { "Default options.\0" }
/* 1000 bytes */
6 RCDATA DISCARDABLE {
 "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789",
 "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789",
 "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789",
 "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789",
 "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789",
 "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789",
 "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789",
 "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789",
 "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789",
 "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
}
/* named ids */
NAMED RCDATA DISCARDABLE { "Named resource.\0" }
Other RCDATA { "Other.\0" }
/* a named type */
7 MYTYPE DISCARDABLE { "Mytype 7.\0" }
Lower MYTYPE { "Mytype Lower.\0" }
/* a user-defined integer type */
1 300 DISCARDABLE { "Type 300.\0" }
