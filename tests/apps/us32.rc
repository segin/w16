/* US32's dialogs (tests/apps/us32.c): a list box 45 dialog units high
   (73 pixels in MS Sans Serif 8: five 13-pixel items and 8 pixels of a
   sixth) with a static just below it, of the class and styles each
   dialog's name stands for */
#include <windows.h>

US32D1 DIALOG 20, 20, 150, 80
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "US32"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "", 101, "LISTBOX", LBS_NOINTEGRALHEIGHT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | WS_TABSTOP | LBS_NOTIFY, 10, 10, 120, 45
    LTEXT "QuickTime support application", 102, 10, 57, 120, 10
END

US32D2 DIALOG 20, 20, 150, 80
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "US32"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "", 101, "US32LB", LBS_NOINTEGRALHEIGHT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | WS_TABSTOP | LBS_NOTIFY, 10, 10, 120, 45
    LTEXT "QuickTime support application", 102, 10, 57, 120, 10
END

