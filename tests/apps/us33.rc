/* US33's dialogs (tests/apps/us33.c): US33O1-8 an owner-drawn list box
   of the styles each one's comment gives, 60 dialog units high, and an OK
   button to take the focus; US33T1-2 a list box with LBS_USETABSTOPS and
   without */
#include <windows.h>

/* fixed, strings */
US33O1 DIALOG 20, 20, 160, 100
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "US33"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "", 101, "LISTBOX", LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | WS_TABSTOP | LBS_NOTIFY, 10, 8, 120, 60
    PUSHBUTTON "OK", 1, 10, 78, 40, 14, WS_TABSTOP
END

/* fixed, no strings, any height */
US33O2 DIALOG 20, 20, 160, 100
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "US33"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "", 101, "LISTBOX", LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | WS_TABSTOP | LBS_NOTIFY, 10, 8, 120, 60
    PUSHBUTTON "OK", 1, 10, 78, 40, 14, WS_TABSTOP
END

