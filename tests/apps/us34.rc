/* US34's dialogs (tests/apps/us34.c): combo boxes of each style and
   several heights in dialog units, edit fields beside them; d1 in MS
   Sans Serif 8, d2 the system font, d3 MS Sans Serif 10, d4 owner-drawn
   drop-down list boxes, d5 laid out as Control Panel's Desktop dialog's
   drop-down list boxes and edit fields (as the screen shows it) */
#include <windows.h>

US34D1 DIALOG 10, 10, 230, 150
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "US34 d1"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "", 101, "ComboBox", CBS_DROPDOWNLIST | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 6, 80, 60
    CONTROL "", 102, "ComboBox", CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 24, 80, 60
    CONTROL "", 103, "ComboBox", CBS_SIMPLE | CBS_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 42, 80, 50
    CONTROL "", 104, "ComboBox", CBS_DROPDOWNLIST | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 6, 80, 12
    CONTROL "", 105, "ComboBox", CBS_DROPDOWN | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 24, 80, 12
    CONTROL "", 106, "ComboBox", CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 42, 80, 100
    CONTROL "", 107, "ComboBox", CBS_SIMPLE | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 60, 80, 30
    EDITTEXT 110, 90, 6, 24, 12, ES_AUTOHSCROLL
    EDITTEXT 111, 90, 24, 24, 10, ES_AUTOHSCROLL
    EDITTEXT 112, 90, 100, 24, 14, ES_AUTOHSCROLL
END

US34D2 DIALOG 10, 10, 230, 150
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "US34 d2"
BEGIN
    CONTROL "", 201, "ComboBox", CBS_DROPDOWNLIST | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 6, 80, 60
    CONTROL "", 202, "ComboBox", CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 24, 80, 60
    CONTROL "", 203, "ComboBox", CBS_SIMPLE | CBS_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 42, 80, 50
    CONTROL "", 204, "ComboBox", CBS_DROPDOWNLIST | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 6, 80, 12
    CONTROL "", 205, "ComboBox", CBS_DROPDOWN | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 24, 80, 12
    CONTROL "", 206, "ComboBox", CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 42, 80, 100
    CONTROL "", 207, "ComboBox", CBS_SIMPLE | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 60, 80, 30
    EDITTEXT 210, 90, 6, 24, 12, ES_AUTOHSCROLL
    EDITTEXT 211, 90, 24, 24, 10, ES_AUTOHSCROLL
    EDITTEXT 212, 90, 100, 24, 14, ES_AUTOHSCROLL
END

US34D3 DIALOG 10, 10, 230, 150
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "US34 d3"
FONT 10, "MS Sans Serif"
BEGIN
    CONTROL "", 301, "ComboBox", CBS_DROPDOWNLIST | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 6, 80, 60
    CONTROL "", 302, "ComboBox", CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 24, 80, 60
    CONTROL "", 303, "ComboBox", CBS_SIMPLE | CBS_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 42, 80, 50
    CONTROL "", 304, "ComboBox", CBS_DROPDOWNLIST | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 6, 80, 12
    CONTROL "", 305, "ComboBox", CBS_DROPDOWN | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 24, 80, 12
    CONTROL "", 306, "ComboBox", CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 42, 80, 100
    CONTROL "", 307, "ComboBox", CBS_SIMPLE | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 60, 80, 30
    EDITTEXT 310, 90, 6, 24, 12, ES_AUTOHSCROLL
    EDITTEXT 311, 90, 24, 24, 10, ES_AUTOHSCROLL
    EDITTEXT 312, 90, 100, 24, 14, ES_AUTOHSCROLL
END

US34D4 DIALOG 10, 10, 230, 150
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "US34 d4"
FONT 8, "MS Sans Serif"
BEGIN
    CONTROL "", 401, "ComboBox", CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 6, 80, 60
    CONTROL "", 402, "ComboBox", CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 6, 30, 80, 60
    CONTROL "", 403, "ComboBox", CBS_DROPDOWNLIST | CBS_OWNERDRAWVARIABLE | CBS_HASSTRINGS | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 6, 80, 60
    CONTROL "", 404, "ComboBox", CBS_DROPDOWN | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 120, 40, 80, 60
    EDITTEXT 410, 90, 6, 24, 12, ES_AUTOHSCROLL
END

US34D5 DIALOG 10, 10, 200, 120
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "Desktop"
FONT 8, "MS Sans Serif"
BEGIN
    GROUPBOX "Pattern", -1, 4, 4, 150, 26
    LTEXT "&Name:", -1, 8, 16, 24, 8
    CONTROL "", 501, "ComboBox", CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 34, 14, 110, 70
    GROUPBOX "Screen Saver", -1, 4, 34, 150, 40
    LTEXT "N&ame:", -1, 8, 46, 24, 8
    CONTROL "", 502, "ComboBox", CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 34, 44, 110, 70
    LTEXT "&Delay:", -1, 8, 60, 24, 8
    EDITTEXT 503, 34, 58, 24, 12
    GROUPBOX "Wallpaper", -1, 4, 78, 90, 26
    LTEXT "&File:", -1, 8, 90, 18, 8
    CONTROL "", 504, "ComboBox", CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 30, 88, 60, 70
    LTEXT "&Spacing:", -1, 100, 90, 30, 8
    EDITTEXT 505, 132, 88, 20, 12
END
