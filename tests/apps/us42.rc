/* US42's icons and dialog (tests/apps/us42.c; the icons from
   tests/apps/us42icons.py) */
#include <windows.h>

1 ICON "us42-1.ico"
2 ICON "us42-2.ico"
3 ICON "us42-3.ico"
4 ICON "us42-4.ico"
5 ICON "us42-5.ico"

US42DLG DIALOG 20, 20, 120, 50
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "US42 dialog"
FONT 8, "Helv"
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 10, 28, 40, 14
    PUSHBUTTON "Cancel", IDCANCEL, 60, 28, 40, 14
END
