/* US43's icons and dialog (tests/apps/us43.c; the icons from
   tests/apps/us43icons.py) */
#include <windows.h>

1 ICON "us43-1.ico"
2 ICON "us43-2.ico"
3 ICON "us43-3.ico"
4 ICON "us43-4.ico"
5 ICON "us43-5.ico"

US43DLG DIALOG 20, 20, 120, 50
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_MODALFRAME
CAPTION "US43 dialog"
FONT 8, "Helv"
BEGIN
    DEFPUSHBUTTON "OK", IDOK, 10, 28, 40, 14
    PUSHBUTTON "Cancel", IDCANCEL, 60, 28, 40, 14
END
